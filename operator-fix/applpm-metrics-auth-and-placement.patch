+// A chosen node that satisfies a Hard region rule must keep passing once its
+// labels are applied; before enrichFromNode the region was always empty.
+func TestEnrichFromNodeKeepsHardRegionRule(t *testing.T) {
+	node := &corev1.Node{
+		ObjectMeta: metav1.ObjectMeta{Name: "enact-dev-worker", Labels: map[string]string{
+			LabelRegion:     "eu-west",
+			LabelGreenRatio: "0.85",
+		}},
+		Status: corev1.NodeStatus{Conditions: []corev1.NodeCondition{
+			{Type: corev1.NodeReady, Status: corev1.ConditionTrue},
+		}},
+	}
+	rp := &enacteuv1alpha1.RuntimePolicy{}
+	rp.Spec.Location = &enacteuv1alpha1.LocationConstraint{Mode: enacteuv1alpha1.Hard, Regions: []string{"eu-west"}}
+
+	m := &enacteuv1alpha1.NodeMetrics{Name: node.Name, Availability: 1}
+	if ok, _ := rp.PassesHard(m, 1, nil); ok {
+		t.Fatal("without labels the Hard region rule should fail; the test no longer covers the bug")
+	}
+
+	enrichFromNode(m, node)
+	if ok, res := rp.PassesHard(m, 1, nil); !ok {
+		t.Fatalf("after enrichFromNode the node should pass, got %q", res)
+	}
+	if m.GreenRatio != 0.85 || !m.Ready {
+		t.Fatalf("enrichFromNode: green=%v ready=%v", m.GreenRatio, m.Ready)
+	}
+}
