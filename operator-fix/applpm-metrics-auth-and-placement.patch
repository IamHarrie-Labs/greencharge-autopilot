+// monitorAPI mimics the TDCME Monitor API: it answers only with the right token.
+func monitorAPI(t *testing.T, token string) *httptest.Server {
+	t.Helper()
+	return httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Header.Get("Authorization") != "Bearer "+token {
+			w.WriteHeader(http.StatusUnauthorized)
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"availability": 0.97}`))
+	}))
+}
+
+func TestApiMetricsSendsBearerToken(t *testing.T) {
+	srv := monitorAPI(t, "s3cret")
+	defer srv.Close()
+
+	a := &ApiMetrics{Client: srv.Client(), BaseURL: srv.URL, ClusterName: "dev", Token: "s3cret"}
+	m, err := a.GetNodeMetrics(context.Background(), "enact-dev-worker")
+	if err != nil {
+		t.Fatalf("GetNodeMetrics: %v", err)
+	}
+	if m.Availability != 0.97 {
+		t.Fatalf("availability = %v, want 0.97", m.Availability)
+	}
+}
+
+func TestApiMetricsWithoutTokenExplains401(t *testing.T) {
+	srv := monitorAPI(t, "s3cret")
+	defer srv.Close()
+
+	a := &ApiMetrics{Client: srv.Client(), BaseURL: srv.URL, ClusterName: "dev"}
+	_, err := a.GetClusterAvailability(context.Background())
+	if err == nil || !strings.Contains(err.Error(), "METRICS_API_TOKEN") {
+		t.Fatalf("want an error naming METRICS_API_TOKEN, got %v", err)
+	}
+}
+
+func TestTokenFromEnvReadsFile(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "token")
+	if err := os.WriteFile(path, []byte("from-file\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("METRICS_API_TOKEN", "")
+	t.Setenv("METRICS_API_TOKEN_FILE", path)
+	if got := tokenFromEnv(); got != "from-file" {
+		t.Fatalf("tokenFromEnv() = %q, want %q", got, "from-file")
+	}
+
+	t.Setenv("METRICS_API_TOKEN", "from-env")
+	if got := tokenFromEnv(); got != "from-env" {
+		t.Fatalf("METRICS_API_TOKEN should take precedence, got %q", got)
+	}
+}
