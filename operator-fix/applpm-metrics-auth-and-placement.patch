+// tokenFromEnv reads the Monitor API token from METRICS_API_TOKEN, or from
+// the file named by METRICS_API_TOKEN_FILE (e.g. a mounted Secret).
+func tokenFromEnv() string {
+	if t := strings.TrimSpace(os.Getenv("METRICS_API_TOKEN")); t != "" {
+		return t
+	}
+	if path := os.Getenv("METRICS_API_TOKEN_FILE"); path != "" {
+		if b, err := os.ReadFile(path); err == nil {
+			return strings.TrimSpace(string(b))
+		}
+	}
+	return ""
+}
