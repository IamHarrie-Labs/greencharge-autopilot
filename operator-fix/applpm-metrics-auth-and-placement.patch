+// enrichFromNode fills the label- and condition-derived fields that the
+// metrics API does not provide.
+func enrichFromNode(m *enacteuv1alpha1.NodeMetrics, n *corev1.Node) {
+	m.Ready = isNodeReady(*n)
+	m.Region = regionOfLabels(n.Labels)
+	m.Zone = zoneOfLabels(n.Labels)
+	m.GreenRatio = greenRatioOfLabels(n.Labels)
+}
